  },
  {
    "start": 950.38,
    "duration": 2.84,
    "text": "Time."
  },
  {
    "start": 950.94,
    "duration": 3.92,
    "text": "And this is what we've got this week."
  },
  {
    "start": 953.22,
    "duration": 3.36,
    "text": "Pigs nose."
  },
  {
    "start": 954.86,
    "duration": 4.68,
    "text": "And that's what it says on the bottle."
  },
  {
    "start": 956.58,
    "duration": 4.12,
    "text": "Smooth as a pigs nose, hopefully."
  },
  {
    "start": 959.54,
    "duration": 1.96,
    "text": "So, we've just got a little one."
  },
  {
    "start": 960.7,
    "duration": 1.64,
    "text": "Smooth, not rough."
  },
  {
    "start": 961.5,
    "duration": 1.4,
