    "duration": 3.08,
    "text": "Um"
  },
  {
    "start": 1040.02,
    "duration": 5.6,
    "text": "Are you some lyrical genius?"
  },
  {
    "start": 1042.3,
    "duration": 3.32,
    "text": "Like a golden syrupy taste."
  },
  {
    "start": 1046.1,
    "duration": 1.6,
    "text": "Don't know if I agree with you there,"
  },
  {
    "start": 1047.14,
