    "duration": 2.52,
    "text": "whiskey review."
  },
  {
    "start": 897.62,
    "duration": 3.48,
    "text": "See you soon, old bean sticks."
  },
  {
    "start": 903.06,
    "duration": 2.28,
    "text": "Right. Is that your last one, mate?"
