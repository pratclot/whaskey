    "text": "Bark."
  },
  {
    "start": 293.76,
    "duration": 1.84,
    "text": "Bark."
  },
  {
    "start": 294.16,
    "duration": 4.44,
    "text": "Just bark all the time, wouldn't he?"
  },
  {
    "start": 295.6,
