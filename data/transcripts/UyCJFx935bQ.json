  {
    "start": 276.24,
    "duration": 3.84,
    "text": "All ready."
  },
  {
    "start": 278.4,
    "duration": 5.72,
    "text": "Is this our stop, lad?"
  },
  {
    "start": 280.08,
    "duration": 4.04,
    "text": "Mhm. It's our stop, son."
  },
  {
    "start": 289.04,
    "duration": 4.0,
    "text": "Dad, what do you think Charlie would do"
  },
