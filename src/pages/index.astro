        position: relative;
        padding-bottom: 56.25%;
        height: 0;
        overflow: hidden;
        border-radius: 10px;
        background: #000;
      }

      .video-embed-wrap iframe {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        border: 0;
      }

      .transcript-content {
        background: var(--bg-deep);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 1.1rem;
        font-size: 0.92rem;
        line-height: 1.65;
        color: var(--text-main);
      }

      .transcript-content :global(p) {
        margin-bottom: 0.75rem;
      }

      .transcript-content :global(strong) {
        color: var(--amber-bright);
      }

      .modal-footer {
        padding: 0.95rem 1.35rem;
        border-top: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.75rem;
        background: var(--bg-deep);
      }

      .empty-state {
        text-align: center;
        padding: 3.5rem 1.5rem;
        background: var(--bg-card);
        border: 1px dashed var(--border);
        border-radius: 14px;
        color: var(--text-muted);
        display: none;
      }

      /* Episodes Catalog View */
      .episodes-toolbar {
        display: none;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 1.1rem;
      }

      .episodes-toolbar.active {
        display: flex;
      }

      .ep-status-pill {
        background: var(--bg-card);
        color: var(--text-muted);
        border: 1px solid var(--border);
        padding: 0.36rem 0.75rem;
        border-radius: 999px;
        font-size: 0.82rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.14s ease;
      }

      .ep-status-pill:hover {
        border-color: var(--amber);
        color: var(--text-main);
      }

      .ep-status-pill.active {
        background: var(--amber-dim);
        color: var(--amber-bright);
        border-color: var(--amber);
      }

      .episodes-grid {
        display: none;
        grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
        gap: 1.15rem;
      }

      .episodes-grid.active {
        display: grid;
      }

      @media (max-width: 420px) {
        .episodes-grid {
          grid-template-columns: 1fr;
        }
      }

      .episode-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 14px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: transform 0.15s ease, border-color 0.15s ease;
      }

      .episode-card:hover {
        border-color: #3f4d44;
        transform: translateY(-2px);
      }

      .episode-card.is-pending {
        border-style: dashed;
        opacity: 0.82;
      }

      .episode-card.is-pending:hover {
        opacity: 1;
      }

      .ep-card-thumb-wrap {
        position: relative;
        aspect-ratio: 16 / 9;
        background: #0b0d0c;
        overflow: hidden;
      }

      .ep-card-thumb {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      .episode-card.is-pending .ep-card-thumb {
        filter: grayscale(40%);
      }

      .ep-duration-badge {
        position: absolute;
        right: 0.55rem;
        bottom: 0.55rem;
        background: rgba(15, 18, 16, 0.86);
        color: var(--text-main);
        font-size: 0.72rem;
        font-weight: 600;
        padding: 0.15rem 0.45rem;
        border-radius: 5px;
      }

      .ep-card-body {
        padding: 1rem 1.1rem 1.1rem;
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
        flex: 1;
      }

      .ep-card-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.4rem;
      }

      .status-badge {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        padding: 0.16rem 0.52rem;
        border-radius: 6px;
      }

      .status-badge.processed {
        background: rgba(56, 176, 0, 0.16);
        color: #7ae582;
        border: 1px solid rgba(56, 176, 0, 0.35);
      }

      .status-badge.pending {
        background: var(--bg-elevated);
        color: var(--text-muted);
        border: 1px solid var(--border);
      }

      .ep-card-title {
        font-size: 1.02rem;
        font-weight: 700;
        color: var(--text-main);
        line-height: 1.32;
      }

      .ep-card-summary {
        font-size: 0.84rem;
        color: var(--text-muted);
        line-height: 1.48;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      .ep-card-actions {
        margin-top: auto;
        padding-top: 0.4rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <header>
        <div>
          <div class="brand-badge">🏕️ Blot Outdoors Show Archive</div>
          <h1>The <span>Whaskey</span> & Scran Tracker</h1>
          <p class="subtitle">
            Every dram, ale, spirit, and campfire meal tasted and rated on the Blot Outdoors Show — searchable by distillery, score, and tasting notes, with timestamped transcripts.
          </p>
        </div>
        <div class="header-actions">
          <button
            id="progress-jump-btn"
            class="archive-progress"
            title="View all episodes and processing status"
          >
            <svg class="progress-ring" viewBox="0 0 40 40" aria-hidden="true">
              <circle class="progress-ring-bg" cx="20" cy="20" r={ringRadius} />
              <circle
                class="progress-ring-fg"
                cx="20"
                cy="20"
                r={ringRadius}
                stroke-dasharray={ringCircumference}
                stroke-dashoffset={ringDashOffset}
              />
            </svg>
            <div class="progress-meta">
              <span class="progress-count">{processedEpisodes} / {totalEpisodes} episodes</span>
              <span class="progress-sub">{progressPct}% indexed • {pendingEpisodes} pending</span>
            </div>
          </button>
          <button id="config-repo-btn" class="repo-btn" title="Configure your GitHub repository for one-click 'Edit on GitHub' links">
            ⚙️ <span id="repo-label">GitHub Repo Settings</span>
          </button>
        </div>
      </header>

      <!-- Filter, Search & Sort Controls -->
      <section class="controls-panel" aria-label="Filters and Sorting">
        <div class="category-tabs" id="category-tabs">
          <button class="cat-tab active" data-category="Whisky">
            🥃 Whaskey Only <span class="cat-count">{categoryCounts['Whisky'] || 0}</span>
          </button>
          <button class="cat-tab" data-category="All">
            ✨ All Rated Items <span class="cat-count">{categoryCounts.All}</span>
          </button>
          <button class="cat-tab" data-category="Beer & Ale">
            🍺 Beer & Ale <span class="cat-count">{categoryCounts['Beer & Ale'] || 0}</span>
          </button>
          <button class="cat-tab" data-category="Spirits & Liqueur">
            🍸 Spirits & Liqueur <span class="cat-count">{categoryCounts['Spirits & Liqueur'] || 0}</span>
          </button>
          <button class="cat-tab" data-category="Food & Scran">
            🍖 Food & Scran <span class="cat-count">{categoryCounts['Food & Scran'] || 0}</span>
          </button>
          {categoryCounts['Other'] > 0 && (
            <button class="cat-tab" data-category="Other">
              🎒 Other <span class="cat-count">{categoryCounts['Other']}</span>
            </button>
          )}
          <button class="cat-tab" data-category="Episodes">
            📺 Episodes <span class="cat-count">{totalEpisodes}</span>
          </button>
        </div>

        <div class="search-sort-row">
          <div class="search-box">
            <span class="search-icon">🔍</span>
            <input
              type="search"
              id="search-input"
              placeholder="Search whaskey name, distillery, region, flavour notes, or episode..."
              autocomplete="off"
            />
          </div>
          <select id="sort-select" class="sort-select" aria-label="Sort ratings">
            <option value="score-desc">Sort: Highest Rating First</option>
            <option value="score-asc">Sort: Lowest Rating First</option>
            <option value="date-desc">Sort: Newest Video First</option>
            <option value="date-asc">Sort: Oldest Video First</option>
            <option value="name-asc">Sort: Name (A → Z)</option>
          </select>
        </div>

        {topTags.length > 0 && (
          <div class="tags-filter-row" id="tag-cloud">
            <span class="tags-label">Flavour & Taste Tags:</span>
            {topTags.map(([tag, count]) => (
              <button class="tag-pill" data-tag={tag}>
                #{tag} <span style="opacity:0.6">({count})</span>
              </button>
            ))}
            <button id="clear-filters-btn" class="clear-filters-btn">Reset filters</button>
          </div>
        )}
      </section>

      <div class="results-bar">
        <span id="results-count">Showing {allItems.length} rated items</span>
        <span style="font-size:0.8rem">Tip: Click <strong>📜 Transcript & Video</strong> to watch the tasting or <strong>✏️ Edit on GitHub</strong> to tweak a review.</span>
      </div>

      <!-- Cards Grid -->
      <main class="cards-grid" id="cards-grid">
        {allItems.map((item) => (
          <article
            class="review-card"
            data-category={item.category}
            data-score={item.rating_score ?? -1}
            data-date={item.publish_date}
            data-name={item.name.toLowerCase()}
            data-tags={item.tags.join(',')}
            data-search={`${item.name} ${item.brand_or_distillery} ${item.region_or_style} ${item.tasting_notes} ${item.verdict_quote} ${item.video_title} ${item.tags.join(' ')}`.toLowerCase()}
          >
            <div class="card-top">
              <div>
                <div class="meta-pills">
                  <span class="cat-badge" data-cat={item.category}>
                    {item.category === 'Whisky' ? '🥃 Whaskey' : item.category}
                  </span>
                  {item.region_or_style && <span class="region-pill">{item.region_or_style}</span>}
                  {item.abv && <span class="region-pill">{item.abv}</span>}
                </div>
                <h2 class="item-title">{item.name}</h2>
                {item.brand_or_distillery && (
                  <div class="distillery-sub">{item.brand_or_distillery}</div>
                )}
              </div>

              <div class="score-box" title={item.rating_raw}>
                <div class="score-num">
                  {item.rating_score !== null ? item.rating_score : '—'}
                </div>
                <div class="score-scale">/ 10</div>
              </div>
            </div>

            <p class="tasting-notes">{item.tasting_notes}</p>

            {item.verdict_quote && (
              <blockquote class="quote-box">“{item.verdict_quote}”</blockquote>
            )}

            {item.tags.length > 0 && (
              <div class="card-tags">
                {item.tags.map((tag) => (
                  <button class="card-tag" data-click-tag={tag}>#{tag}</button>
                ))}
              </div>
            )}

            <div class="episode-context">
              <div class="ep-row">
                <img class="ep-thumb" src={item.thumbnail} alt={item.video_title} loading="lazy" />
                <div class="ep-info">
                  <div class="ep-title" title={item.video_title}>{item.video_title}</div>
                  <div class="ep-date">{item.publish_date} • Tasting at {item.timestamp_display}</div>
                </div>
              </div>

              <div class="card-actions">
                <button
                  class="btn btn-watch open-modal-btn"
                  data-video-id={item.video_id}
                  data-timestamp={item.timestamp_seconds}
                  data-item-name={item.name}
                  data-video-title={item.video_title}
                >
                  ▶ Watch & Transcript ({item.timestamp_display})
                </button>
                <a
                  class="btn"
                  href={`https://www.youtube.com/watch?v=${item.video_id}&t=${item.timestamp_seconds}s`}
                  target="_blank"
                  rel="noopener noreferrer"
                  title="Open directly on YouTube at this timestamp"
                >
                  YouTube ↗
                </a>
                <a
                  class="btn btn-edit github-edit-link"
                  data-video-id={item.video_id}
                  href="#"
                  target="_blank"
                  rel="noopener noreferrer"
                  title="Edit this review & transcript directly on GitHub (commits straight to main for repo owner)"
                >
                  ✏️ Edit
                </a>
              </div>
            </div>
          </article>
        ))}
      </main>

      <div id="episodes-toolbar" class="episodes-toolbar">
        <button class="ep-status-pill active" data-ep-status="all">All ({totalEpisodes})</button>
        <button class="ep-status-pill" data-ep-status="processed">✅ Processed ({processedEpisodes})</button>
        <button class="ep-status-pill" data-ep-status="pending">⏳ Pending ({pendingEpisodes})</button>
      </div>

      <section class="episodes-grid" id="episodes-grid" aria-label="All Channel Episodes">
        {allEpisodes.map((ep) => (
          <article
            class={`episode-card ${ep.processed ? 'is-processed' : 'is-pending'}`}
            data-ep-status={ep.processed ? 'processed' : 'pending'}
            data-search={ep.search_blob}
          >
            <div class="ep-card-thumb-wrap">
              <img class="ep-card-thumb" src={ep.thumbnail} alt={ep.title} loading="lazy" />
              {ep.duration_string && <span class="ep-duration-badge">{ep.duration_string}</span>}
            </div>
            <div class="ep-card-body">
              <div class="ep-card-meta">
                {ep.processed ? (
                  <span class="status-badge processed">✅ Processed</span>
                ) : (
                  <span class="status-badge pending">⏳ Pending</span>
                )}
                {ep.processed && (
                  <span class="region-pill">
                    {ep.item_count > 0 ? `${ep.item_count} ${ep.item_count === 1 ? 'item' : 'items'} rated` : 'No tastings'}
                  </span>
                )}
                {ep.publish_date && <span class="region-pill">{ep.publish_date}</span>}
              </div>

              <h2 class="ep-card-title">{ep.title}</h2>

              {ep.processed ? (
                ep.episode_summary && <p class="ep-card-summary">{ep.episode_summary}</p>
              ) : (
                <p class="ep-card-summary">Not yet transcribed or extracted.</p>
              )}

              <div class="ep-card-actions">
                {ep.processed && (
                  <button
                    class="btn btn-watch open-modal-btn"
                    data-video-id={ep.video_id}
                    data-timestamp="0"
                    data-item-name={ep.title}
                    data-video-title={ep.publish_date || 'Processed Episode'}
                  >
                    ▶ Watch & Transcript
                  </button>
                )}
                <a
                  class="btn"
                  href={`https://www.youtube.com/watch?v=${ep.video_id}`}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  YouTube ↗
                </a>
                {ep.processed && (
                  <a
                    class="btn btn-edit github-edit-link"
                    data-video-id={ep.video_id}
                    href="#"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    ✏️ Edit
                  </a>
                )}
              </div>
            </div>
          </article>
        ))}
      </section>

      <div id="empty-state" class="empty-state">
        <h3>No rated items match your current filters</h3>
        <p style="margin-top:0.4rem">Try switching to "All Rated Items" or clearing your search and flavour tag filters.</p>
      </div>
    </div>

    <!-- Pre-rendered hidden transcript bodies per episode -->
    <div style="display:none" id="transcript-store">
      {episodesWithContent.map((ep) => (
        <div id={`transcript-${ep.video_id}`}>
          <ep.Content />
        </div>
      ))}
    </div>

    <!-- Transcript & Video Player Modal -->
    <div class="modal-backdrop" id="tasting-modal" role="dialog" aria-modal="true">
      <div class="modal-card">
        <div class="modal-header">
          <div>
            <h3 id="modal-title">Tasting Review</h3>
            <div id="modal-subtitle" style="font-size:0.8rem;color:var(--text-muted)"></div>
          </div>
          <button class="modal-close" id="close-tasting-modal" aria-label="Close">&times;</button>
        </div>
        <div class="modal-body">
          <div class="video-embed-wrap" id="modal-video-container"></div>
          <div>
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.5rem">
              <strong style="font-size:0.85rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--amber)">
                📜 Episode Tasting Transcript Excerpt
              </strong>
              <span style="font-size:0.76rem;color:var(--text-muted)">
                File: <code id="modal-file-path">src/content/reviews/id.md</code>
              </span>
            </div>
            <div class="transcript-content" id="modal-transcript-body"></div>
          </div>
        </div>
        <div class="modal-footer">
          <span style="font-size:0.8rem;color:var(--text-muted)">
            Spot a mangled Scottish distillery name in the captions?
          </span>
          <a
            id="modal-github-edit"
            class="btn btn-watch"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
          >
            ✏️ Edit Review & Transcript on GitHub
          </a>
        </div>
      </div>
    </div>

    <script define:vars={{ defaultGithubRepo, defaultGithubBranch }}>
      const STORAGE_KEY = 'blot_github_repo';
      let githubRepo = localStorage.getItem(STORAGE_KEY) || defaultGithubRepo || '';
      const githubBranch = defaultGithubBranch || 'main';

      const repoBtn = document.getElementById('config-repo-btn');
      const repoLabel = document.getElementById('repo-label');

      function getEditUrl(videoId) {
        if (!githubRepo) return '#configure-repo';
        return `https://github.com/${githubRepo}/edit/${githubBranch}/src/content/reviews/${videoId}.md`;
      }

      function refreshEditLinks() {
        if (repoLabel) {
          repoLabel.textContent = githubRepo ? `Repo: ${githubRepo}` : 'Set GitHub Repo for Editing';
        }
        document.querySelectorAll('.github-edit-link').forEach((el) => {
          const vid = el.getAttribute('data-video-id');
          el.setAttribute('href', getEditUrl(vid));
        });
      }

      function promptForRepo() {
        const input = window.prompt(
          'Enter your GitHub repository (owner/repo) so "✏️ Edit" links open GitHub\'s web editor directly for your repo:\n\nExample: your-username/whaskey',
          githubRepo || 'your-username/blot'
        );
        if (input !== null && input.trim()) {
          githubRepo = input.trim().replace(/^https?:\/\/github\.com\//, '').replace(/\/$/, '');
          localStorage.setItem(STORAGE_KEY, githubRepo);
          refreshEditLinks();
        }
      }

      repoBtn?.addEventListener('click', promptForRepo);

      document.addEventListener('click', (e) => {
        const link = e.target.closest('.github-edit-link, #modal-github-edit');
        if (link && !githubRepo) {
          e.preventDefault();
          promptForRepo();
          if (githubRepo) {
            const vid = link.getAttribute('data-video-id');
            if (vid) window.open(getEditUrl(vid), '_blank', 'noopener');
          }
        }
      });

      refreshEditLinks();

      // Filtering & Sorting State
      let activeCategory = 'Whisky'; // Default to Whaskey Only as requested!
      let activeTags = new Set();
      let activeEpisodeStatus = 'all';
      let searchQuery = '';
      let currentSort = 'score-desc';

      const cardsGrid = document.getElementById('cards-grid');
      const cards = Array.from(document.querySelectorAll('.review-card'));
      const episodesGrid = document.getElementById('episodes-grid');
      const episodeCards = Array.from(document.querySelectorAll('.episode-card'));
      const episodesToolbar = document.getElementById('episodes-toolbar');
      const tagCloud = document.getElementById('tag-cloud');
      const resultsCount = document.getElementById('results-count');
      const emptyState = document.getElementById('empty-state');
      const clearFiltersBtn = document.getElementById('clear-filters-btn');
      const searchInput = document.getElementById('search-input');
      const sortSelect = document.getElementById('sort-select');
      const progressJumpBtn = document.getElementById('progress-jump-btn');

      // If there are no Whisky items yet (unlikely), fall back to All
      const hasWhisky = cards.some((c) => c.getAttribute('data-category') === 'Whisky');
      if (!hasWhisky) activeCategory = 'All';

      function applyFiltersAndSort() {
        const isEpisodesMode = activeCategory === 'Episodes';

        if (cardsGrid) cardsGrid.style.display = isEpisodesMode ? 'none' : 'grid';
        if (tagCloud) tagCloud.style.display = isEpisodesMode ? 'none' : 'flex';
        if (sortSelect) sortSelect.style.display = isEpisodesMode ? 'none' : 'block';
        episodesToolbar?.classList.toggle('active', isEpisodesMode);
        episodesGrid?.classList.toggle('active', isEpisodesMode);

        let visibleCount = 0;

        if (isEpisodesMode) {
          episodeCards.forEach((card) => {
            const status = card.getAttribute('data-ep-status');
            const searchBlob = card.getAttribute('data-search') || '';
            const matchesStatus = activeEpisodeStatus === 'all' || status === activeEpisodeStatus;
            const matchesSearch = !searchQuery || searchBlob.includes(searchQuery);

            if (matchesStatus && matchesSearch) {
              card.style.display = 'flex';
              visibleCount++;
            } else {
              card.style.display = 'none';
            }
          });

          if (resultsCount) {
            const label =
              activeEpisodeStatus === 'processed'
                ? 'processed episode'
                : activeEpisodeStatus === 'pending'
                  ? 'pending episode'
                  : 'episode';
            resultsCount.textContent = `Showing ${visibleCount} ${label}${visibleCount === 1 ? '' : 's'}`;
          }
          if (emptyState) {
            emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
          }
          if (clearFiltersBtn) {
            clearFiltersBtn.style.display = searchQuery !== '' ? 'inline-block' : 'none';
          }
          return;
        }

        // Sort cards first
        cards.sort((a, b) => {
          const scoreA = parseFloat(a.getAttribute('data-score') || '-1');
          const scoreB = parseFloat(b.getAttribute('data-score') || '-1');
          const dateA = a.getAttribute('data-date') || '';
          const dateB = b.getAttribute('data-date') || '';
          const nameA = a.getAttribute('data-name') || '';
          const nameB = b.getAttribute('data-name') || '';

          if (currentSort === 'score-desc') {
            if (scoreB !== scoreA) return scoreB - scoreA;
            return dateB.localeCompare(dateA);
          }
          if (currentSort === 'score-asc') {
            const sA = scoreA < 0 ? 999 : scoreA;
            const sB = scoreB < 0 ? 999 : scoreB;
            if (sA !== sB) return sA - sB;
            return dateB.localeCompare(dateA);
          }
          if (currentSort === 'date-desc') return dateB.localeCompare(dateA);
          if (currentSort === 'date-asc') return dateA.localeCompare(dateB);
          if (currentSort === 'name-asc') return nameA.localeCompare(nameB);
          return 0;
        });

        cards.forEach((card) => {
          cardsGrid.appendChild(card);

          const cat = card.getAttribute('data-category');
          const cardTags = (card.getAttribute('data-tags') || '').split(',').filter(Boolean);
          const searchBlob = card.getAttribute('data-search') || '';

          const matchesCat = activeCategory === 'All' || cat === activeCategory;
          const matchesSearch = !searchQuery || searchBlob.includes(searchQuery);
          const matchesTags =
            activeTags.size === 0 ||
            Array.from(activeTags).every((t) => cardTags.includes(t));

          if (matchesCat && matchesSearch && matchesTags) {
            card.style.display = 'flex';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (resultsCount) {
          const catLabel = activeCategory === 'Whisky' ? 'whaskey' : 'rated';
          resultsCount.textContent = `Showing ${visibleCount} ${catLabel} item${visibleCount === 1 ? '' : 's'}`;
        }
        if (emptyState) {
          emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
        }
        if (clearFiltersBtn) {
          clearFiltersBtn.style.display =
            activeTags.size > 0 || searchQuery !== '' ? 'inline-block' : 'none';
        }
      }

      // Category Tab Clicks
      function setActiveTab(category) {
        document.querySelectorAll('.cat-tab').forEach((b) => {
          b.classList.toggle('active', b.getAttribute('data-category') === category);
        });
        activeCategory = category;
        applyFiltersAndSort();
      }

      document.querySelectorAll('.cat-tab').forEach((btn) => {
        btn.addEventListener('click', () => {
          setActiveTab(btn.getAttribute('data-category') || 'All');
        });
      });

      progressJumpBtn?.addEventListener('click', () => {
        setActiveTab('Episodes');
        document.getElementById('category-tabs')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });

      document.querySelectorAll('.ep-status-pill').forEach((pill) => {
        pill.addEventListener('click', () => {
          document.querySelectorAll('.ep-status-pill').forEach((p) => p.classList.remove('active'));
          pill.classList.add('active');
          activeEpisodeStatus = pill.getAttribute('data-ep-status') || 'all';
          applyFiltersAndSort();
        });
      });

      // Tag Cloud & Card Tag Clicks
      function toggleTag(tag) {
        if (activeTags.has(tag)) {
          activeTags.delete(tag);
        } else {
          activeTags.add(tag);
        }
        document.querySelectorAll('.tag-pill').forEach((pill) => {
          const t = pill.getAttribute('data-tag');
          pill.classList.toggle('active', activeTags.has(t));
        });
        applyFiltersAndSort();
      }

      document.querySelectorAll('.tag-pill').forEach((pill) => {
        pill.addEventListener('click', () => {
          const tag = pill.getAttribute('data-tag');
          if (tag) toggleTag(tag);
        });
      });

      document.querySelectorAll('.card-tag').forEach((tagBtn) => {
        tagBtn.addEventListener('click', () => {
          const tag = tagBtn.getAttribute('data-click-tag');
          if (tag) toggleTag(tag);
        });
      });

      clearFiltersBtn?.addEventListener('click', () => {
        activeTags.clear();
        searchQuery = '';
        if (searchInput) searchInput.value = '';
        document.querySelectorAll('.tag-pill').forEach((p) => p.classList.remove('active'));
        applyFiltersAndSort();
      });

      searchInput?.addEventListener('input', (e) => {
        searchQuery = e.target.value.toLowerCase().trim();
        applyFiltersAndSort();
      });

      sortSelect?.addEventListener('change', (e) => {
        currentSort = e.target.value;
        applyFiltersAndSort();
      });

      // Modal Handling
      const modal = document.getElementById('tasting-modal');
      const closeModalBtn = document.getElementById('close-tasting-modal');
      const modalTitle = document.getElementById('modal-title');
      const modalSubtitle = document.getElementById('modal-subtitle');
      const modalVideoContainer = document.getElementById('modal-video-container');
      const modalTranscriptBody = document.getElementById('modal-transcript-body');
      const modalFilePath = document.getElementById('modal-file-path');
      const modalGithubEdit = document.getElementById('modal-github-edit');

      document.querySelectorAll('.open-modal-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const vid = btn.getAttribute('data-video-id');
          const ts = btn.getAttribute('data-timestamp') || '0';
          const itemName = btn.getAttribute('data-item-name') || '';
          const videoTitle = btn.getAttribute('data-video-title') || '';

          if (modalTitle) modalTitle.textContent = itemName;
          if (modalSubtitle) modalSubtitle.textContent = videoTitle;
          if (modalFilePath) modalFilePath.textContent = `src/content/reviews/${vid}.md`;
          if (modalGithubEdit) {
            modalGithubEdit.setAttribute('data-video-id', vid);
            modalGithubEdit.setAttribute('href', getEditUrl(vid));
          }

          if (modalVideoContainer) {
            modalVideoContainer.innerHTML = `<iframe src="https://www.youtube.com/embed/${vid}?start=${ts}&autoplay=1" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>`;
          }

          const storedTranscript = document.getElementById(`transcript-${vid}`);
          if (modalTranscriptBody) {
            modalTranscriptBody.innerHTML = storedTranscript
              ? storedTranscript.innerHTML
              : '<p>No transcript excerpt available.</p>';
          }

          modal?.classList.add('open');
        });
      });

      function closeModal() {
        modal?.classList.remove('open');
        if (modalVideoContainer) modalVideoContainer.innerHTML = '';
      }

      closeModalBtn?.addEventListener('click', closeModal);
      modal?.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeModal();
      });

      applyFiltersAndSort();
    </script>
  </body>
</html>
