---
import fs from 'node:fs';
import path from 'node:path';
import { getCollection, render } from 'astro:content';

const entries = await getCollection('reviews');

// Render markdown body (transcript excerpt) for each episode
const episodesWithContent = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    return {
      ...entry.data,
      id: entry.id,
      rawBody: entry.body || '',
      Content,
    };
  })
);

// Flatten all rated items across episodes for filtering/sorting
interface FlatItem {
  itemIndex: number;
  name: string;
  category: string;
  brand_or_distillery: string;
  region_or_style: string;
  abv: string;
  timestamp_seconds: number;
  timestamp_display: string;
  rating_score: number | null;
  rating_raw: string;
  tags: string[];
  tasting_notes: string;
  verdict_quote: string;
  video_id: string;
  video_title: string;
  publish_date: string;
  thumbnail: string;
  episode_summary: string;
  manually_edited: boolean;
}

const allItems: FlatItem[] = [];
const tagCounts: Record<string, number> = {};
const categoryCounts: Record<string, number> = {
  All: 0,
  Whisky: 0,
  'Beer & Ale': 0,
  'Spirits & Liqueur': 0,
  'Food & Scran': 0,
  Other: 0,
};

for (const ep of episodesWithContent) {
  for (let idx = 0; idx < ep.items.length; idx++) {
    const item = ep.items[idx];
    const cleanTags = (item.tags || []).map((t) => t.toLowerCase().trim()).filter(Boolean);
    for (const tag of cleanTags) {
      tagCounts[tag] = (tagCounts[tag] || 0) + 1;
    }
    categoryCounts.All++;
    categoryCounts[item.category] = (categoryCounts[item.category] || 0) + 1;

    allItems.push({
      itemIndex: idx,
      name: item.name,
      category: item.category,
      brand_or_distillery: item.brand_or_distillery || '',
      region_or_style: item.region_or_style || '',
      abv: item.abv || '',
      timestamp_seconds: item.timestamp_seconds || 0,
      timestamp_display: item.timestamp_display || '00:00',
      rating_score: item.rating_score ?? null,
      rating_raw: item.rating_raw || 'Unrated',
      tags: cleanTags,
      tasting_notes: item.tasting_notes || '',
      verdict_quote: item.verdict_quote || '',
      video_id: ep.video_id,
      video_title: ep.video_title,
      publish_date: ep.publish_date,
      thumbnail: ep.thumbnail || `https://i.ytimg.com/vi/${ep.video_id}/hqdefault.jpg`,
      episode_summary: ep.episode_summary || '',
      manually_edited: ep.manually_edited || false,
    });
  }
}

// Sort tags by frequency descending
const topTags = Object.entries(tagCounts)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 28);

// Default sort: highest score first, then newest video
allItems.sort((a, b) => {
  const scoreA = a.rating_score ?? -1;
  const scoreB = b.rating_score ?? -1;
  if (scoreB !== scoreA) return scoreB - scoreA;
  return b.publish_date.localeCompare(a.publish_date);
});

// Build full episode list (processed + pending) from channel_videos.jsonl
interface EpisodeCard {
  video_id: string;
  title: string;
  duration_string: string;
  thumbnail: string;
  processed: boolean;
  has_reviews: boolean;
  item_count: number;
  publish_date: string;
  episode_summary: string;
  search_blob: string;
}

const episodeById = new Map(episodesWithContent.map((ep) => [ep.video_id, ep]));
const allEpisodes: EpisodeCard[] = [];
const seenVideoIds = new Set<string>();

const catalogPath = path.resolve(process.cwd(), 'data/channel_videos.jsonl');
if (fs.existsSync(catalogPath)) {
  const rawLines = fs.readFileSync(catalogPath, 'utf-8').split('\n');
  for (const line of rawLines) {
    const trimmed = line.trim();
    if (!trimmed) continue;
    try {
      const row = JSON.parse(trimmed);
      const vid = row.id;
      if (!vid || seenVideoIds.has(vid)) continue;
      seenVideoIds.add(vid);
      const processedEp = episodeById.get(vid);
      const thumbs = Array.isArray(row.thumbnails) ? row.thumbnails : [];
      const fallbackThumb = `https://i.ytimg.com/vi/${vid}/hqdefault.jpg`;
      const catalogThumb = thumbs.length > 0 && thumbs[0]?.url ? thumbs[0].url : fallbackThumb;
      const title = processedEp?.video_title || row.title || vid;
      const summary = processedEp?.episode_summary || '';
      allEpisodes.push({
        video_id: vid,
        title,
        duration_string: row.duration_string || '',
        thumbnail: processedEp?.thumbnail || catalogThumb,
        processed: Boolean(processedEp),
        has_reviews: processedEp ? processedEp.has_reviews : false,
        item_count: processedEp ? processedEp.items.length : 0,
        publish_date: processedEp?.publish_date || '',
        episode_summary: summary,
        search_blob: `${title} ${summary} ${vid}`.toLowerCase(),
      });
    } catch {
      // Skip malformed JSONL line
    }
  }
}

// Include any processed reviews that are not in channel_videos.jsonl
for (const ep of episodesWithContent) {
  if (seenVideoIds.has(ep.video_id)) continue;
  seenVideoIds.add(ep.video_id);
  allEpisodes.push({
    video_id: ep.video_id,
    title: ep.video_title,
    duration_string: '',
    thumbnail: ep.thumbnail || `https://i.ytimg.com/vi/${ep.video_id}/hqdefault.jpg`,
    processed: true,
    has_reviews: ep.has_reviews,
    item_count: ep.items.length,
    publish_date: ep.publish_date,
    episode_summary: ep.episode_summary || '',
    search_blob: `${ep.video_title} ${ep.episode_summary || ''} ${ep.video_id}`.toLowerCase(),
  });
}

const totalEpisodes = allEpisodes.length;
const processedEpisodes = allEpisodes.filter((e) => e.processed).length;
const pendingEpisodes = totalEpisodes - processedEpisodes;
const progressPct = totalEpisodes > 0 ? Math.round((processedEpisodes / totalEpisodes) * 1000) / 10 : 0;
const ringRadius = 16;
const ringCircumference = 2 * Math.PI * ringRadius;
const ringDashOffset = ringCircumference * (1 - progressPct / 100);

const defaultGithubRepo = import.meta.env.PUBLIC_GITHUB_REPO || import.meta.env.GITHUB_REPO || 'pratclot/whaskey';
const defaultGithubBranch = import.meta.env.PUBLIC_GITHUB_BRANCH || 'main';
