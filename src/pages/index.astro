        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 16px;
        max-width: 780px;
        width: 100%;
        max-height: 88vh;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
