# Gemini API Key (get a free key at https://aistudio.google.com/apikey)
GEMINI_API_KEY="your_gemini_api_key_here"

# Optional: Your GitHub repository (owner/repo) for one-click "Edit on GitHub" links
PUBLIC_GITHUB_REPO="your-username/blot"
PUBLIC_GITHUB_BRANCH="main"

# Optional: SSH target (user@host) for SOCKS5 proxy tunnel in scripts/run_timer.sh
SSH_PROXY_TARGET=""
